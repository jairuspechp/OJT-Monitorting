{
  "name": "Monitoring-Tool",
  "productName": "Link Layouts",
  "version": "2.1.0",
  "description": "Link Layouts dashboard with a local SQLite database",
  "author": "Link Layouts",
  "main": "main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:folder": "electron-builder --win dir",
    "build:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.monitoringtool.app",
    "productName": "Monitoring Tool",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "index.html",
      "app.js",
      "style.css",
      "package.json",
      "RTdbX.ico",
      "RTdbX.png"
    ],
    "win": {
      "target": ["portable"],
      "icon": "RTdbX.ico"
    },
    "portable": {
      "artifactName": "Monitoring-Tool.exe"
    },
    "extraResources": [
      { "from": "Db.sqlite", "to": "seed.sqlite" }
    ]
  }
  
}
