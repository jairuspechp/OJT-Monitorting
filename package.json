{
  "name": "link-layouts",
  "productName": "Link Layouts",
  "version": "2.1.0",
  "description": "Link Layouts dashboard with a local SQLite database",
  "author": "Link Layouts",
  "main": "main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:folder": "electron-builder --win dir",
    "build:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.linklayouts.app",
    "productName": "Link Layouts",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "index.html",
      "app.js",
      "style.css",
      "package.json",
      "icon.ico"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "RTdbX.ico"
    },
    "portable": {
      "artifactName": "Link-Layouts.exe"
    }
  }
}
